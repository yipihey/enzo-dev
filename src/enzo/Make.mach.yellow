MACH_TEXT  = Stanford yellow: Rocky Linux 8, gcc/g++/gfortran 11, OpenMPI 4.1.4, system HDF5/FFTW3
MACH_VALID = 1
MACH_FILE  = Make.mach.yellow

LOCAL_MPI_INSTALL     = /opt/openmpi-4.1.4/gcc-11.2.1
LOCAL_HDF5_INSTALL    = /usr
LOCAL_GRACKLE_INSTALL =

MACH_CPP       = cpp

MACH_CC_MPI    = $(LOCAL_MPI_INSTALL)/bin/mpicc
MACH_CXX_MPI   = $(LOCAL_MPI_INSTALL)/bin/mpic++
MACH_FC_MPI    = gfortran
MACH_F90_MPI   = gfortran
MACH_LD_MPI    = $(LOCAL_MPI_INSTALL)/bin/mpic++

MACH_CC_NOMPI  = gcc
MACH_CXX_NOMPI = g++
MACH_FC_NOMPI  = gfortran
MACH_F90_NOMPI = gfortran
MACH_LD_NOMPI  = g++

MACH_DEFINES   = -DLINUX -DH5_USE_16_API

MACH_CPPFLAGS  = -P -traditional
MACH_CFLAGS    =
MACH_CXXFLAGS  =
MACH_FFLAGS    = -fno-second-underscore -ffixed-line-length-132 -fallow-argument-mismatch
MACH_F90FLAGS  = -fno-second-underscore -fallow-argument-mismatch
MACH_LDFLAGS   =

MACH_OPT_WARN        = -Wall -g
MACH_OPT_DEBUG       = -g
MACH_OPT_HIGH        = -O2
MACH_OPT_AGGRESSIVE  = -O3 -g

LOCAL_INCLUDES_MPI    = -I$(LOCAL_MPI_INSTALL)/include
LOCAL_INCLUDES_HDF5   = -I$(LOCAL_HDF5_INSTALL)/include

MACH_INCLUDES         = $(LOCAL_INCLUDES_HDF5)
MACH_INCLUDES_MPI     = $(LOCAL_INCLUDES_MPI)

LOCAL_LIBS_MPI    = -L$(LOCAL_MPI_INSTALL)/lib -lmpi
LOCAL_LIBS_HDF5   = -L$(LOCAL_HDF5_INSTALL)/lib64 -lhdf5 -lz
LOCAL_LIBS_MACH   = -lgfortran

MACH_LIBS         = $(LOCAL_LIBS_HDF5) $(LOCAL_LIBS_MACH)
MACH_LIBS_MPI     = $(LOCAL_LIBS_MPI)
